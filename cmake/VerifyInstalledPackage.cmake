cmake_minimum_required(VERSION 3.23)

get_filename_component(CAORS_VERIFY_REPOSITORY_ROOT "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
set(CAORS_VERIFY_BUILD_ROOT "${CAORS_VERIFY_REPOSITORY_ROOT}/build")
cmake_path(NORMAL_PATH CAORS_VERIFY_BUILD_ROOT)

function(caors_require_variable VARIABLE_NAME)
  if(NOT DEFINED ${VARIABLE_NAME} OR "${${VARIABLE_NAME}}" STREQUAL "")
    message(FATAL_ERROR "缺少必需参数 -D${VARIABLE_NAME}=...")
  endif()
endfunction()

function(caors_normalize_output_path VARIABLE_NAME OUTPUT_VARIABLE)
  caors_require_variable("${VARIABLE_NAME}")
  get_filename_component(
    NORMALIZED_PATH
    "${${VARIABLE_NAME}}"
    ABSOLUTE
    BASE_DIR "${CAORS_VERIFY_REPOSITORY_ROOT}"
  )
  cmake_path(NORMAL_PATH NORMALIZED_PATH)
  cmake_path(IS_PREFIX CAORS_VERIFY_BUILD_ROOT "${NORMALIZED_PATH}" NORMALIZE IS_IN_BUILD_ROOT)
  if(NOT IS_IN_BUILD_ROOT OR NORMALIZED_PATH STREQUAL CAORS_VERIFY_BUILD_ROOT)
    message(
      FATAL_ERROR
      "${VARIABLE_NAME} 必须是工作区 build/ 下的具体子目录：${NORMALIZED_PATH}"
    )
  endif()
  set(${OUTPUT_VARIABLE} "${NORMALIZED_PATH}" PARENT_SCOPE)
endfunction()

function(caors_read_cache_value CACHE_FILE VARIABLE_NAME OUTPUT_VARIABLE)
  file(
    STRINGS "${CACHE_FILE}" CACHE_LINES
    REGEX "^${VARIABLE_NAME}:[^=]*="
    LIMIT_COUNT 1
  )
  if(NOT CACHE_LINES)
    message(FATAL_ERROR "${CACHE_FILE} 缺少 ${VARIABLE_NAME}")
  endif()
  string(REGEX REPLACE "^[^=]*=" "" CACHE_VALUE "${CACHE_LINES}")
  set(${OUTPUT_VARIABLE} "${CACHE_VALUE}" PARENT_SCOPE)
endfunction()

function(caors_require_disjoint_paths LEFT_NAME LEFT_PATH RIGHT_NAME RIGHT_PATH)
  set(NORMALIZED_LEFT "${LEFT_PATH}")
  set(NORMALIZED_RIGHT "${RIGHT_PATH}")
  cmake_path(IS_PREFIX NORMALIZED_LEFT "${NORMALIZED_RIGHT}" NORMALIZE RIGHT_IN_LEFT)
  cmake_path(IS_PREFIX NORMALIZED_RIGHT "${NORMALIZED_LEFT}" NORMALIZE LEFT_IN_RIGHT)
  if(RIGHT_IN_LEFT OR LEFT_IN_RIGHT)
    message(
      FATAL_ERROR
      "${LEFT_NAME} 与 ${RIGHT_NAME} 不能相同或互相嵌套："
      "${NORMALIZED_LEFT}；${NORMALIZED_RIGHT}"
    )
  endif()
endfunction()

function(caors_run_step STEP_NAME)
  execute_process(
    COMMAND ${ARGN}
    RESULT_VARIABLE STEP_RESULT
    COMMAND_ECHO STDOUT
  )
  if(NOT STEP_RESULT EQUAL 0)
    message(FATAL_ERROR "${STEP_NAME} 失败，退出码：${STEP_RESULT}")
  endif()
endfunction()

function(caors_configure_and_run_consumer PACKAGE_PREFIX CONSUMER_BUILD_DIR)
  set(CONFIGURE_COMMAND
      "${CMAKE_COMMAND}"
      -S "${CAORS_VERIFY_CONSUMER_SOURCE_DIR}"
      -B "${CONSUMER_BUILD_DIR}"
      -G "${CAORS_VERIFY_GENERATOR}"
      "-DCMAKE_PREFIX_PATH:PATH=${PACKAGE_PREFIX}"
      "-DCMAKE_CXX_COMPILER:FILEPATH=${CAORS_VERIFY_CXX_COMPILER}"
      "-DCAORS_INSTALLED_SHARED:BOOL=${CAORS_VERIFY_SHARED}"
  )
  if(CAORS_VERIFY_SHARED)
    if(WIN32)
      list(APPEND CONFIGURE_COMMAND
           "-DCAORS_INSTALLED_RUNTIME_DIR:PATH=${PACKAGE_PREFIX}/bin")
    else()
      list(APPEND CONFIGURE_COMMAND
           "-DCAORS_INSTALLED_RUNTIME_DIR:PATH=${PACKAGE_PREFIX}/lib")
    endif()
  endif()
  if(NOT CAORS_VERIFY_MULTI_CONFIG)
    list(APPEND CONFIGURE_COMMAND "-DCMAKE_BUILD_TYPE:STRING=${CAORS_VERIFY_CONFIG}")
  endif()

  caors_run_step("配置 installed consumer" ${CONFIGURE_COMMAND})
  caors_run_step(
    "构建 installed consumer"
    "${CMAKE_COMMAND}" --build "${CONSUMER_BUILD_DIR}" --config "${CAORS_VERIFY_CONFIG}"
  )
  caors_run_step(
    "运行 installed consumer"
    "${CAORS_VERIFY_CTEST}" --test-dir "${CONSUMER_BUILD_DIR}"
    --build-config "${CAORS_VERIFY_CONFIG}" --output-on-failure
  )

  caors_read_cache_value(
    "${CONSUMER_BUILD_DIR}/CMakeCache.txt" caors_DIR RESOLVED_CAORS_DIR
  )
  cmake_path(IS_PREFIX PACKAGE_PREFIX "${RESOLVED_CAORS_DIR}" NORMALIZE USES_EXPECTED_PREFIX)
  if(NOT USES_EXPECTED_PREFIX)
    message(
      FATAL_ERROR
      "consumer 使用了预期前缀之外的 CAORS package：${RESOLVED_CAORS_DIR}"
    )
  endif()
endfunction()

caors_require_variable(CAORS_PRODUCER_BUILD_DIR)
caors_require_variable(CAORS_INSTALL_PREFIX)
caors_require_variable(CAORS_CONSUMER_BUILD_DIR)
caors_require_variable(CAORS_RELOCATION_PREFIX)
caors_require_variable(CAORS_RELOCATED_CONSUMER_BUILD_DIR)
caors_require_variable(CAORS_BUILD_CONFIG)
caors_require_variable(CAORS_SHARED)

caors_normalize_output_path(CAORS_PRODUCER_BUILD_DIR CAORS_VERIFY_PRODUCER_BUILD_DIR)
caors_normalize_output_path(CAORS_INSTALL_PREFIX CAORS_VERIFY_INSTALL_PREFIX)
caors_normalize_output_path(CAORS_CONSUMER_BUILD_DIR CAORS_VERIFY_CONSUMER_BUILD_DIR)
caors_normalize_output_path(CAORS_RELOCATION_PREFIX CAORS_VERIFY_RELOCATION_PREFIX)
caors_normalize_output_path(
  CAORS_RELOCATED_CONSUMER_BUILD_DIR CAORS_VERIFY_RELOCATED_CONSUMER_BUILD_DIR
)

set(
  CAORS_VERIFY_OUTPUT_PATH_NAMES
  CAORS_INSTALL_PREFIX
  CAORS_CONSUMER_BUILD_DIR
  CAORS_RELOCATION_PREFIX
  CAORS_RELOCATED_CONSUMER_BUILD_DIR
)
set(
  CAORS_VERIFY_OUTPUT_PATHS
  "${CAORS_VERIFY_INSTALL_PREFIX}"
  "${CAORS_VERIFY_CONSUMER_BUILD_DIR}"
  "${CAORS_VERIFY_RELOCATION_PREFIX}"
  "${CAORS_VERIFY_RELOCATED_CONSUMER_BUILD_DIR}"
)
list(LENGTH CAORS_VERIFY_OUTPUT_PATHS OUTPUT_PATH_COUNT)
math(EXPR LAST_OUTPUT_PATH_INDEX "${OUTPUT_PATH_COUNT} - 1")
foreach(LEFT_INDEX RANGE 0 ${LAST_OUTPUT_PATH_INDEX})
  list(GET CAORS_VERIFY_OUTPUT_PATH_NAMES ${LEFT_INDEX} LEFT_NAME)
  list(GET CAORS_VERIFY_OUTPUT_PATHS ${LEFT_INDEX} LEFT_PATH)
  caors_require_disjoint_paths(
    CAORS_PRODUCER_BUILD_DIR "${CAORS_VERIFY_PRODUCER_BUILD_DIR}"
    "${LEFT_NAME}" "${LEFT_PATH}"
  )
  math(EXPR RIGHT_INDEX "${LEFT_INDEX} + 1")
  if(RIGHT_INDEX LESS OUTPUT_PATH_COUNT)
    foreach(CURRENT_RIGHT_INDEX RANGE ${RIGHT_INDEX} ${LAST_OUTPUT_PATH_INDEX})
      list(GET CAORS_VERIFY_OUTPUT_PATH_NAMES ${CURRENT_RIGHT_INDEX} RIGHT_NAME)
      list(GET CAORS_VERIFY_OUTPUT_PATHS ${CURRENT_RIGHT_INDEX} RIGHT_PATH)
      caors_require_disjoint_paths(
        "${LEFT_NAME}" "${LEFT_PATH}" "${RIGHT_NAME}" "${RIGHT_PATH}"
      )
    endforeach()
  endif()
endforeach()

set(CAORS_VERIFY_CONFIG "${CAORS_BUILD_CONFIG}")
set(CAORS_VERIFY_SHARED "${CAORS_SHARED}")
set(
  CAORS_VERIFY_CONSUMER_SOURCE_DIR
  "${CAORS_VERIFY_REPOSITORY_ROOT}/tests/installed_package/consumer"
)

set(PRODUCER_CACHE "${CAORS_VERIFY_PRODUCER_BUILD_DIR}/CMakeCache.txt")
if(NOT EXISTS "${PRODUCER_CACHE}")
  message(FATAL_ERROR "producer 尚未配置：${PRODUCER_CACHE}")
endif()

caors_read_cache_value("${PRODUCER_CACHE}" CMAKE_GENERATOR CAORS_VERIFY_GENERATOR)
caors_read_cache_value("${PRODUCER_CACHE}" CMAKE_CXX_COMPILER CAORS_VERIFY_CXX_COMPILER)
caors_read_cache_value("${PRODUCER_CACHE}" BUILD_SHARED_LIBS PRODUCER_SHARED)
if(CAORS_VERIFY_SHARED)
  if(NOT PRODUCER_SHARED)
    message(FATAL_ERROR "脚本要求 Shared，但 producer 的 BUILD_SHARED_LIBS=OFF")
  endif()
elseif(PRODUCER_SHARED)
  message(FATAL_ERROR "脚本要求 Static，但 producer 的 BUILD_SHARED_LIBS=ON")
endif()
file(
  STRINGS "${PRODUCER_CACHE}" CONFIGURATION_TYPES_LINE
  REGEX "^CMAKE_CONFIGURATION_TYPES:[^=]*="
  LIMIT_COUNT 1
)
if(CONFIGURATION_TYPES_LINE)
  set(CAORS_VERIFY_MULTI_CONFIG TRUE)
else()
  set(CAORS_VERIFY_MULTI_CONFIG FALSE)
  caors_read_cache_value("${PRODUCER_CACHE}" CMAKE_BUILD_TYPE PRODUCER_BUILD_TYPE)
  if(NOT PRODUCER_BUILD_TYPE STREQUAL CAORS_VERIFY_CONFIG)
    message(
      FATAL_ERROR
      "脚本配置为 ${CAORS_VERIFY_CONFIG}，但 producer 是 ${PRODUCER_BUILD_TYPE}"
    )
  endif()
endif()

get_filename_component(CMAKE_PROGRAM_DIRECTORY "${CMAKE_COMMAND}" DIRECTORY)
find_program(
  CAORS_VERIFY_CTEST
  NAMES ctest
  HINTS "${CMAKE_PROGRAM_DIRECTORY}"
  REQUIRED
  NO_DEFAULT_PATH
)

foreach(
  OUTPUT_DIRECTORY
  IN ITEMS
    "${CAORS_VERIFY_INSTALL_PREFIX}"
    "${CAORS_VERIFY_CONSUMER_BUILD_DIR}"
    "${CAORS_VERIFY_RELOCATION_PREFIX}"
    "${CAORS_VERIFY_RELOCATED_CONSUMER_BUILD_DIR}"
)
  file(REMOVE_RECURSE "${OUTPUT_DIRECTORY}")
endforeach()

caors_run_step(
  "安装 CAORS"
  "${CMAKE_COMMAND}" --install "${CAORS_VERIFY_PRODUCER_BUILD_DIR}"
  --prefix "${CAORS_VERIFY_INSTALL_PREFIX}" --config "${CAORS_VERIFY_CONFIG}"
)
caors_configure_and_run_consumer(
  "${CAORS_VERIFY_INSTALL_PREFIX}" "${CAORS_VERIFY_CONSUMER_BUILD_DIR}"
)

file(MAKE_DIRECTORY "${CAORS_VERIFY_RELOCATION_PREFIX}")
file(COPY "${CAORS_VERIFY_INSTALL_PREFIX}/" DESTINATION "${CAORS_VERIFY_RELOCATION_PREFIX}")
caors_configure_and_run_consumer(
  "${CAORS_VERIFY_RELOCATION_PREFIX}" "${CAORS_VERIFY_RELOCATED_CONSUMER_BUILD_DIR}"
)

file(
  GLOB_RECURSE RELOCATED_CMAKE_FILES
  LIST_DIRECTORIES FALSE
  "${CAORS_VERIFY_RELOCATION_PREFIX}/*.cmake"
)
list(APPEND RELOCATED_CMAKE_FILES
     "${CAORS_VERIFY_RELOCATED_CONSUMER_BUILD_DIR}/CMakeCache.txt")
foreach(RELOCATED_FILE IN LISTS RELOCATED_CMAKE_FILES)
  file(READ "${RELOCATED_FILE}" RELOCATED_CONTENT)
  string(FIND "${RELOCATED_CONTENT}" "${CAORS_VERIFY_INSTALL_PREFIX}" OLD_PREFIX_POSITION)
  if(NOT OLD_PREFIX_POSITION EQUAL -1)
    message(FATAL_ERROR "迁移后文件仍引用旧安装前缀：${RELOCATED_FILE}")
  endif()
endforeach()

message(
  STATUS
  "CAORS installed package 验证通过：shared=${CAORS_VERIFY_SHARED}, "
  "config=${CAORS_VERIFY_CONFIG}, relocated=${CAORS_VERIFY_RELOCATION_PREFIX}"
)
