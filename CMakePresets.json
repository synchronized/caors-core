{
  "version": 4,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 23,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base-ninja",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "environment": {
        "NINJA_STATUS": "[%f/%t] ",
        "PYTHONUNBUFFERED": "1"
      },
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": true
      }
    },
    {
      "name": "config-debug",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "USE_DEBUG_OUTPUT": true,
        "USE_LOG": true,
        "USE_LOG_SEVERITY": "0"
      }
    },
    {
      "name": "config-release",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "USE_DEBUG_OUTPUT": false,
        "USE_LOG": false
      }
    },
    {
      "name": "linkage-shared",
      "hidden": true,
      "cacheVariables": {
        "BUILD_SHARED_LIBS": true
      }
    },
    {
      "name": "sanitizer-asan",
      "hidden": true,
      "cacheVariables": {
        "CAORS_ENABLE_ASAN": true
      }
    },
    {
      "name": "toolchain-clang",
      "hidden": true,
      "inherits": "base-ninja",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++"
      }
    },
    {
      "name": "toolchain-gcc",
      "hidden": true,
      "inherits": "base-ninja",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++"
      }
    },
    {
      "name": "toolchain-msvc",
      "hidden": true,
      "inherits": "base-ninja",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "cl",
        "CMAKE_CXX_COMPILER": "cl"
      }
    },
    {
      "name": "toolchain-clang-cl",
      "hidden": true,
      "inherits": "base-ninja",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang-cl",
        "CMAKE_CXX_COMPILER": "clang-cl"
      }
    },
    {
      "name": "platform-windows",
      "hidden": true,
      "architecture": {
        "value": "x64",
        "strategy": "external"
      },
      "toolset": {
        "value": "host=x64",
        "strategy": "external"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "vendor": {
        "microsoft.com/VisualStudioSettings/CMake/1.0": {
          "hostOS": [
            "Windows"
          ]
        }
      }
    },
    {
      "name": "platform-linux",
      "hidden": true,
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "generator-vs2022",
      "hidden": true,
      "inherits": "platform-windows",
      "generator": "Visual Studio 17 2022",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "architecture": "x64"
    },
    {
      "name": "windows-msvc-debug",
      "displayName": "Windows x64 MSVC Debug",
      "inherits": [
        "platform-windows",
        "toolchain-msvc",
        "config-debug"
      ]
    },
    {
      "name": "windows-msvc-release",
      "displayName": "Windows x64 MSVC Release",
      "inherits": [
        "platform-windows",
        "toolchain-msvc",
        "config-release"
      ]
    },
    {
      "name": "windows-vs2022-debug",
      "displayName": "Windows x64 Visual Studio 2022 Debug",
      "inherits": "generator-vs2022",
      "cacheVariables": {
        "USE_DEBUG_OUTPUT": true,
        "USE_LOG": true,
        "USE_LOG_SEVERITY": "0"
      }
    },
    {
      "name": "windows-vs2022-release",
      "displayName": "Windows x64 Visual Studio 2022 Release",
      "inherits": "generator-vs2022",
      "cacheVariables": {
        "USE_DEBUG_OUTPUT": false,
        "USE_LOG": false
      }
    },
    {
      "name": "windows-clang-cl-debug",
      "displayName": "Windows x64 clang-cl Debug",
      "inherits": [
        "platform-windows",
        "toolchain-clang-cl",
        "config-debug"
      ]
    },
    {
      "name": "windows-clang-cl-release",
      "displayName": "Windows x64 clang-cl Release",
      "inherits": [
        "platform-windows",
        "toolchain-clang-cl",
        "config-release"
      ]
    },
    {
      "name": "windows-clang-debug",
      "displayName": "Windows x64 Clang Debug",
      "inherits": [
        "platform-windows",
        "toolchain-clang",
        "config-debug"
      ]
    },
    {
      "name": "windows-clang-release",
      "displayName": "Windows x64 Clang Release",
      "inherits": [
        "platform-windows",
        "toolchain-clang",
        "config-release"
      ]
    },
    {
      "name": "windows-clang-shared-debug",
      "displayName": "Windows x64 Clang Shared Debug",
      "inherits": [
        "platform-windows",
        "toolchain-clang",
        "config-debug",
        "linkage-shared"
      ]
    },
    {
      "name": "windows-clang-shared-release",
      "displayName": "Windows x64 Clang Shared Release",
      "inherits": [
        "platform-windows",
        "toolchain-clang",
        "config-release",
        "linkage-shared"
      ]
    },
    {
      "name": "windows-clang-benchmark",
      "displayName": "Windows x64 Clang Benchmark",
      "inherits": [
        "platform-windows",
        "toolchain-clang",
        "config-release"
      ],
      "cacheVariables": {
        "CAORS_BUILD_BENCHMARKS": true
      }
    },
    {
      "name": "linux-clang-debug",
      "displayName": "Linux Clang Debug",
      "inherits": [
        "platform-linux",
        "toolchain-clang",
        "config-debug"
      ]
    },
    {
      "name": "linux-clang-release",
      "displayName": "Linux Clang Release",
      "inherits": [
        "platform-linux",
        "toolchain-clang",
        "config-release"
      ]
    },
    {
      "name": "linux-clang-shared-debug",
      "displayName": "Linux Clang Shared Debug",
      "inherits": [
        "platform-linux",
        "toolchain-clang",
        "config-debug",
        "linkage-shared"
      ]
    },
    {
      "name": "linux-clang-shared-release",
      "displayName": "Linux Clang Shared Release",
      "inherits": [
        "platform-linux",
        "toolchain-clang",
        "config-release",
        "linkage-shared"
      ]
    },
    {
      "name": "linux-clang-shared-asan",
      "displayName": "Linux Clang Shared ASan",
      "inherits": [
        "platform-linux",
        "toolchain-clang",
        "config-debug",
        "linkage-shared",
        "sanitizer-asan"
      ]
    },
    {
      "name": "linux-clang-benchmark",
      "displayName": "Linux Clang Benchmark",
      "inherits": [
        "platform-linux",
        "toolchain-clang",
        "config-release"
      ],
      "cacheVariables": {
        "CAORS_BUILD_BENCHMARKS": true
      }
    },
    {
      "name": "linux-gcc-debug",
      "displayName": "Linux GCC Debug",
      "inherits": [
        "platform-linux",
        "toolchain-gcc",
        "config-debug"
      ]
    },
    {
      "name": "linux-gcc-release",
      "displayName": "Linux GCC Release",
      "inherits": [
        "platform-linux",
        "toolchain-gcc",
        "config-release"
      ]
    }
  ],
  "buildPresets": [
    {
      "name": "build-windows",
      "hidden": true,
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "build-linux",
      "hidden": true,
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "windows-vs2022-debug",
      "inherits": "build-windows",
      "configurePreset": "windows-vs2022-debug",
      "configuration": "Debug"
    },
    {
      "name": "windows-vs2022-release",
      "inherits": "build-windows",
      "configurePreset": "windows-vs2022-release",
      "configuration": "Release"
    },
    {
      "name": "windows-msvc-debug",
      "inherits": "build-windows",
      "configurePreset": "windows-msvc-debug"
    },
    {
      "name": "windows-msvc-release",
      "inherits": "build-windows",
      "configurePreset": "windows-msvc-release"
    },
    {
      "name": "windows-clang-cl-debug",
      "inherits": "build-windows",
      "configurePreset": "windows-clang-cl-debug"
    },
    {
      "name": "windows-clang-cl-release",
      "inherits": "build-windows",
      "configurePreset": "windows-clang-cl-release"
    },
    {
      "name": "windows-clang-debug",
      "inherits": "build-windows",
      "configurePreset": "windows-clang-debug"
    },
    {
      "name": "windows-clang-release",
      "inherits": "build-windows",
      "configurePreset": "windows-clang-release"
    },
    {
      "name": "windows-clang-shared-debug",
      "inherits": "build-windows",
      "configurePreset": "windows-clang-shared-debug"
    },
    {
      "name": "windows-clang-shared-release",
      "inherits": "build-windows",
      "configurePreset": "windows-clang-shared-release"
    },
    {
      "name": "windows-clang-benchmark",
      "inherits": "build-windows",
      "configurePreset": "windows-clang-benchmark"
    },
    {
      "name": "linux-clang-debug",
      "inherits": "build-linux",
      "configurePreset": "linux-clang-debug"
    },
    {
      "name": "linux-clang-release",
      "inherits": "build-linux",
      "configurePreset": "linux-clang-release"
    },
    {
      "name": "linux-clang-shared-debug",
      "inherits": "build-linux",
      "configurePreset": "linux-clang-shared-debug"
    },
    {
      "name": "linux-clang-shared-release",
      "inherits": "build-linux",
      "configurePreset": "linux-clang-shared-release"
    },
    {
      "name": "linux-clang-shared-asan",
      "inherits": "build-linux",
      "configurePreset": "linux-clang-shared-asan"
    },
    {
      "name": "linux-clang-benchmark",
      "inherits": "build-linux",
      "configurePreset": "linux-clang-benchmark"
    },
    {
      "name": "linux-gcc-debug",
      "inherits": "build-linux",
      "configurePreset": "linux-gcc-debug"
    },
    {
      "name": "linux-gcc-release",
      "inherits": "build-linux",
      "configurePreset": "linux-gcc-release"
    }
  ],
  "testPresets": [
    {
      "name": "test-default",
      "hidden": true,
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error",
        "stopOnFailure": false
      }
    },
    {
      "name": "test-windows",
      "hidden": true,
      "inherits": "test-default",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "test-linux",
      "hidden": true,
      "inherits": "test-default",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "windows-vs2022-debug",
      "configurePreset": "windows-vs2022-debug",
      "inherits": "test-windows",
      "configuration": "Debug"
    },
    {
      "name": "windows-vs2022-release",
      "configurePreset": "windows-vs2022-release",
      "inherits": "test-windows",
      "configuration": "Release"
    },
    {
      "name": "windows-msvc-debug",
      "configurePreset": "windows-msvc-debug",
      "inherits": "test-windows"
    },
    {
      "name": "windows-msvc-release",
      "configurePreset": "windows-msvc-release",
      "inherits": "test-windows"
    },
    {
      "name": "windows-clang-cl-debug",
      "configurePreset": "windows-clang-cl-debug",
      "inherits": "test-windows"
    },
    {
      "name": "windows-clang-cl-release",
      "configurePreset": "windows-clang-cl-release",
      "inherits": "test-windows"
    },
    {
      "name": "windows-clang-debug",
      "configurePreset": "windows-clang-debug",
      "inherits": "test-windows"
    },
    {
      "name": "windows-clang-release",
      "configurePreset": "windows-clang-release",
      "inherits": "test-windows"
    },
    {
      "name": "windows-clang-shared-debug",
      "configurePreset": "windows-clang-shared-debug",
      "inherits": "test-windows"
    },
    {
      "name": "windows-clang-shared-release",
      "configurePreset": "windows-clang-shared-release",
      "inherits": "test-windows"
    },
    {
      "name": "linux-clang-debug",
      "configurePreset": "linux-clang-debug",
      "inherits": "test-linux"
    },
    {
      "name": "linux-clang-release",
      "configurePreset": "linux-clang-release",
      "inherits": "test-linux"
    },
    {
      "name": "linux-clang-shared-debug",
      "configurePreset": "linux-clang-shared-debug",
      "inherits": "test-linux"
    },
    {
      "name": "linux-clang-shared-release",
      "configurePreset": "linux-clang-shared-release",
      "inherits": "test-linux"
    },
    {
      "name": "linux-clang-shared-asan",
      "configurePreset": "linux-clang-shared-asan",
      "inherits": "test-linux"
    },
    {
      "name": "linux-gcc-debug",
      "configurePreset": "linux-gcc-debug",
      "inherits": "test-linux"
    },
    {
      "name": "linux-gcc-release",
      "configurePreset": "linux-gcc-release",
      "inherits": "test-linux"
    }
  ]
}
