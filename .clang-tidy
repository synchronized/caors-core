---
Checks: >
  -*,
  bugprone-*,
  performance-*,
  portability-*,
  modernize-*,
  -modernize-use-trailing-return-type,
  readability-*,
  -readability-identifier-length,
  -readability-magic-numbers
WarningsAsErrors: ''
HeaderFilterRegex: '^(?!.*[\\/]3rd[\\/]).*'
SystemHeaders: false
FormatStyle: file
...
