if(NOT DEFINED CAORS_SOURCE_DIR OR NOT DEFINED CAORS_TEST_BINARY_DIR)
  message(FATAL_ERROR "缺少依赖缓存测试目录")
endif()
string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef nonce)
set(test_root "${CAORS_TEST_BINARY_DIR}/${nonce}")
file(MAKE_DIRECTORY "${test_root}/input/fixture")
file(WRITE "${test_root}/input/fixture/entry.txt" "cache contract fixture")
string(REPEAT "dependency-cache\n" 65536 payload)
file(WRITE "${test_root}/input/fixture/payload.txt" "${payload}")
set(archive "${test_root}/fixture.tar.gz")
execute_process(COMMAND "${CMAKE_COMMAND}" -E tar cfz "${archive}" --format=gnutar fixture
  WORKING_DIRECTORY "${test_root}/input" RESULT_VARIABLE packed)
if(NOT packed EQUAL 0)
  message(FATAL_ERROR "无法生成测试归档")
endif()
file(SHA256 "${archive}" digest)
if(WIN32)
  set(archive_url "file:///${archive}")
else()
  set(archive_url "file://${archive}")
endif()
string(REPLACE "%" "%25" archive_url "${archive_url}")
string(REPLACE " " "%20" archive_url "${archive_url}")
string(REPLACE "#" "%23" archive_url "${archive_url}")
set(worker "${test_root}/worker.cmake")
file(CONFIGURE OUTPUT "${worker}" CONTENT [=[
set(CAORS_ROOT_DIR "@CAORS_SOURCE_DIR@")
include("@CAORS_SOURCE_DIR@/cmake/caors_dependency_cache.cmake")
set(CAORS_DEPENDENCY_SOURCE_CACHE_DIR "${CACHE_ROOT}")
set(CAORS_DEPENDENCY_OFFLINE "${OFFLINE}")
if(DEFINED LOCK_TIMEOUT)
  set(CAORS_DEPENDENCY_LOCK_TIMEOUT "${LOCK_TIMEOUT}")
endif()
if(NOT DEFINED NAME)
  set(NAME sample)
endif()
if(DEFINED WAIT_FOR)
  foreach(attempt RANGE 1 100)
    if(EXISTS "${WAIT_FOR}")
      break()
    endif()
    execute_process(COMMAND "${CMAKE_COMMAND}" -E sleep 0.05)
  endforeach()
  if(NOT EXISTS "${WAIT_FOR}")
    message(FATAL_ERROR "等待锁持有者超时")
  endif()
endif()
caors_prepare_source_cache("${NAME}" "${URL}" "${HASH}" "${MARKER}" prepared)
if(DEFINED OUTPUT_FILE)
  file(WRITE "${OUTPUT_FILE}" "${prepared}")
endif()
]=] @ONLY NEWLINE_STYLE UNIX)

function(run_worker label cache offline expect_success)
  execute_process(COMMAND "${CMAKE_COMMAND}" "-DCACHE_ROOT=${cache}" "-DOFFLINE=${offline}"
    "-DURL=${archive_url}" "-DHASH=${digest}" -DMARKER=entry.txt ${ARGN} -P "${worker}"
    RESULT_VARIABLE code OUTPUT_VARIABLE output ERROR_VARIABLE errors TIMEOUT 30)
  file(WRITE "${test_root}/${label}.log" "${output}${errors}")
  if(expect_success)
    if(NOT code STREQUAL "0")
      message(FATAL_ERROR "${label} 失败：${output}${errors}")
    endif()
  elseif(code STREQUAL "0")
    message(FATAL_ERROR "${label} 错误地成功")
  endif()
  set(last_output "${output}${errors}" PARENT_SCOPE)
endfunction()

run_worker(cold "${test_root}/cold" OFF TRUE)
set(published "${test_root}/cold/sources/sample/${digest}")
file(READ "${published}/entry.txt" entry)
file(READ "${published}/.caors-source-complete" receipt)
if(NOT entry STREQUAL "cache contract fixture" OR NOT receipt STREQUAL "${digest}\n")
  message(FATAL_ERROR "冷缓存发布内容或完成标记无效")
endif()
file(GLOB stages "${test_root}/cold/staging/*")
if(stages)
  message(FATAL_ERROR "成功后没有清理本次 staging")
endif()
run_worker(warm_offline "${test_root}/cold" ON TRUE -DURL=invalid://must-not-be-used)
run_worker(offline_miss "${test_root}/missing" ON FALSE)
if(NOT last_output MATCHES "缓存缺失")
  message(FATAL_ERROR "离线缺失诊断错误：${last_output}")
endif()
file(MAKE_DIRECTORY "${test_root}/archive_only/archives")
file(COPY_FILE "${archive}" "${test_root}/archive_only/archives/sample-${digest}.tar.gz")
run_worker(archive_offline "${test_root}/archive_only" ON TRUE -DURL=invalid://must-not-be-used)

file(MAKE_DIRECTORY "${test_root}/bad_archive/archives")
set(bad_archive "${test_root}/bad_archive/archives/sample-${digest}.tar.gz")
file(WRITE "${bad_archive}" "preserve invalid archive")
run_worker(bad_archive "${test_root}/bad_archive" OFF FALSE)
file(READ "${bad_archive}" preserved)
if(NOT last_output MATCHES "归档摘要不匹配" OR NOT preserved STREQUAL "preserve invalid archive")
  message(FATAL_ERROR "损坏归档未正确诊断或被覆盖")
endif()
string(REPEAT "0" 64 wrong_digest)
run_worker(bad_download "${test_root}/bad_download" OFF FALSE "-DHASH=${wrong_digest}")
if(NOT last_output MATCHES "下载摘要不匹配" OR
   EXISTS "${test_root}/bad_download/archives/sample-${wrong_digest}.tar.gz" OR
   EXISTS "${test_root}/bad_download/sources/sample/${wrong_digest}")
  message(FATAL_ERROR "摘要失败被错误发布：${last_output}")
endif()
file(MAKE_DIRECTORY "${test_root}/partial/sources/sample/${digest}")
file(WRITE "${test_root}/partial/sources/sample/${digest}/entry.txt" "preserve partial source")
run_worker(partial "${test_root}/partial" ON FALSE)
file(READ "${test_root}/partial/sources/sample/${digest}/entry.txt" preserved)
if(NOT last_output MATCHES "源码缓存不完整" OR NOT preserved STREQUAL "preserve partial source")
  message(FATAL_ERROR "不完整源码被错误接受或覆盖")
endif()
file(WRITE "${test_root}/partial/sources/sample/${digest}/.caors-source-complete" "wrong receipt")
run_worker(wrong_receipt "${test_root}/partial" ON FALSE)
if(NOT last_output MATCHES "源码缓存不完整")
  message(FATAL_ERROR "错误完成标记被接受")
endif()
run_worker(invalid_name "${test_root}/invalid_name" OFF FALSE -DNAME=../escape)
run_worker(invalid_timeout "${test_root}/invalid_timeout" OFF FALSE -DLOCK_TIMEOUT=-1)
if(EXISTS "${test_root}/invalid_name" OR EXISTS "${test_root}/invalid_timeout")
  message(FATAL_ERROR "无效参数不应创建缓存目录")
endif()
run_worker(missing_marker "${test_root}/bad_marker" OFF FALSE -DMARKER=absent.txt)
if(NOT last_output MATCHES "缺少入口" OR EXISTS "${test_root}/bad_marker/sources/sample/${digest}")
  message(FATAL_ERROR "入口缺失被错误发布")
endif()
run_worker(invalid_marker "${test_root}/invalid_marker" OFF FALSE -DMARKER=../escape)
if(EXISTS "${test_root}/invalid_marker")
  message(FATAL_ERROR "无效 marker 不应触碰缓存")
endif()

# execute_process 的多个 COMMAND 并发运行；同项竞争必须只发布一个完整结果。
set(shared_cache "${test_root}/parallel")
execute_process(
  COMMAND "${CMAKE_COMMAND}" "-DCACHE_ROOT=${shared_cache}" -DOFFLINE=OFF
    "-DURL=${archive_url}" "-DHASH=${digest}" -DMARKER=entry.txt
    "-DOUTPUT_FILE=${test_root}/parallel-a.txt" -P "${worker}"
  COMMAND "${CMAKE_COMMAND}" "-DCACHE_ROOT=${shared_cache}" -DOFFLINE=OFF
    "-DURL=${archive_url}" "-DHASH=${digest}" -DMARKER=entry.txt
    "-DOUTPUT_FILE=${test_root}/parallel-b.txt" -P "${worker}"
  RESULTS_VARIABLE codes OUTPUT_VARIABLE output ERROR_VARIABLE errors TIMEOUT 30)
if(NOT codes STREQUAL "0;0")
  message(FATAL_ERROR "并发准备失败：${codes}：${output}${errors}")
endif()
file(READ "${test_root}/parallel-a.txt" first)
file(READ "${test_root}/parallel-b.txt" second)
if(NOT first STREQUAL second OR NOT EXISTS "${first}/.caors-source-complete")
  message(FATAL_ERROR "并发调用没有得到同一完整源码")
endif()

# 同名但不同修订使用不同锁与发布目录，不能在并行准备时串用内容。
file(MAKE_DIRECTORY "${test_root}/input-two/fixture")
file(WRITE "${test_root}/input-two/fixture/entry.txt" "revision two")
set(second_archive "${test_root}/version-two.tar.gz")
execute_process(COMMAND "${CMAKE_COMMAND}" -E tar cfz "${second_archive}" --format=gnutar fixture
  WORKING_DIRECTORY "${test_root}/input-two" RESULT_VARIABLE packed)
if(NOT packed EQUAL 0)
  message(FATAL_ERROR "无法生成第二修订归档")
endif()
file(SHA256 "${second_archive}" second_digest)
string(REGEX REPLACE "fixture\\.tar\\.gz$" "version-two.tar.gz" second_url "${archive_url}")
set(revision_cache "${test_root}/parallel_revisions")
execute_process(
  COMMAND "${CMAKE_COMMAND}" "-DCACHE_ROOT=${revision_cache}" -DOFFLINE=OFF
    "-DURL=${archive_url}" "-DHASH=${digest}" -DMARKER=entry.txt
    "-DOUTPUT_FILE=${test_root}/revision-a.txt" -P "${worker}"
  COMMAND "${CMAKE_COMMAND}" "-DCACHE_ROOT=${revision_cache}" -DOFFLINE=OFF
    "-DURL=${second_url}" "-DHASH=${second_digest}" -DMARKER=entry.txt
    "-DOUTPUT_FILE=${test_root}/revision-b.txt" -P "${worker}"
  RESULTS_VARIABLE codes OUTPUT_VARIABLE output ERROR_VARIABLE errors TIMEOUT 30)
if(NOT codes STREQUAL "0;0")
  message(FATAL_ERROR "并行修订准备失败：${codes}：${output}${errors}")
endif()
file(READ "${test_root}/revision-a.txt" first)
file(READ "${test_root}/revision-b.txt" second)
file(READ "${first}/entry.txt" first_content)
file(READ "${second}/entry.txt" second_content)
if(first STREQUAL second OR NOT first_content STREQUAL "cache contract fixture" OR
   NOT second_content STREQUAL "revision two")
  message(FATAL_ERROR "同名修订之间串用了缓存内容")
endif()

set(holder "${test_root}/holder.cmake")
file(CONFIGURE OUTPUT "${holder}" CONTENT [=[
file(MAKE_DIRECTORY "${CACHE_ROOT}/locks")
file(LOCK "${CACHE_ROOT}/locks/sample-@digest@.lock" GUARD PROCESS TIMEOUT 0)
file(WRITE "${READY}" "ready")
execute_process(COMMAND "${CMAKE_COMMAND}" -E sleep 3)
]=] @ONLY NEWLINE_STYLE UNIX)
foreach(mode IN ITEMS timeout independent)
  set(cache "${test_root}/lock_${mode}")
  set(ready "${test_root}/${mode}.ready")
  set(name sample)
  if(mode STREQUAL "independent")
    set(name other)
  endif()
  execute_process(
    COMMAND "${CMAKE_COMMAND}" "-DCACHE_ROOT=${cache}" "-DREADY=${ready}" -P "${holder}"
    COMMAND "${CMAKE_COMMAND}" "-DCACHE_ROOT=${cache}" -DOFFLINE=OFF -DLOCK_TIMEOUT=0
      "-DNAME=${name}" "-DWAIT_FOR=${ready}" "-DURL=${archive_url}" "-DHASH=${digest}"
      -DMARKER=entry.txt -P "${worker}"
    RESULTS_VARIABLE codes OUTPUT_VARIABLE output ERROR_VARIABLE errors TIMEOUT 20)
  list(GET codes 0 held_code)
  list(GET codes 1 worker_code)
  if(NOT held_code STREQUAL "0")
    message(FATAL_ERROR "锁持有者失败：${errors}")
  endif()
  if(mode STREQUAL "timeout")
    if(worker_code STREQUAL "0" OR NOT errors MATCHES "缓存锁失败")
      message(FATAL_ERROR "同项争用未按超时失败：${codes}：${errors}")
    endif()
    # 持有进程结束后，残留锁文件本身不应阻止新调用。
    run_worker(after_holder_exit "${cache}" OFF TRUE -DLOCK_TIMEOUT=0)
  elseif(NOT worker_code STREQUAL "0")
    message(FATAL_ERROR "不同依赖不应被同一把锁阻塞：${errors}")
  endif()
endforeach()
message(STATUS "依赖缓存契约通过：冷/暖/离线、损坏/不完整、并发发布、锁超时与按项隔离")
